class Solution:
    def maxProfit(self, prices: List[int]) -> int:
        min_price = float('inf')
        max_profit = 0

        # found the lowest price
        for price in prices:
            if price < min_price:
                min_price = price
            
            # using that price calculate the current profit

            c_profit = price - min_price
            if c_profit > max_profit:
                max_profit = c_profit
            
        return max_profit
        